__pycache__/
*.py[cod]
.venv/
.cache/
.env
.env.*
datasets/private/
datasets/private_holdout/
# PoL2 生成中间产物：分片与批次可由 cases/questions 复算，不入库
datasets/pol2/**/shards/
# 大体积派生文件只提交压缩版，明文保留在本机供校验脚本使用
datasets/pol2/**/*.questions.jsonl
# 递归匹配：早先写成 data/*.jsonl 只覆盖直接子文件，jev/ 等子目录因此漏网
# 并曾把含 benchmark 成员与语料正文的流水线记录提交进仓库
datasets/general/data/**/*.jsonl
# 内部 benchmark 不进公开仓库：单独交付给维护者上传私有托管
datasets/general/data/splits/benchmark*
# 派生数据的明文与缓存不入库
datasets/general/data/splits/*.jsonl
datasets/general/data/**/__pycache__/
**/raw-private/
**/*.safetensors
**/*.gguf
**/*.pt
**/*.bin

# 外部送来的项目包（含标注产物，不得进公开仓库）
datasets/pol2/*.tar.gz

# 内部 Agent 工作区：状态快照、交接文档、接手 prompt、过程笔记与阶段报告（只在本机）
.agent/

# 数据集大文件不入库：托管在 Hugging Face，仓库只保留数据卡、清单与校验脚本
datasets/general/data/**/*.gz
# Hugging Face 导出目录是生成物（含数据实体），由 export_hf.py 复算
datasets/general/data/hf-export/
# 专用数据集解压与切分产物（含 blind_test，绝不入库）
datasets/pol2/data/
# PoL2 冒烟/试点生成物（可由流水线重跑，不再跟踪）
datasets/pol2/pipeline/smoke/anchor-migration-report.json
datasets/pol2/v0.1-pilot/train.cases.jsonl
